{
  "info": {
    "name": "API v1 - Auth, Admin, User, Driver, Store",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth APIs",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Invite Admin",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/invite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "invite"]
            }
          }
        },
        {
          "name": "Verify Admin Invite Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/verify?token=INVITE_TOKEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "verify"],
              "query": [
                { "key": "token", "value": "INVITE_TOKEN" }
              ]
            }
          }
        },
        {
          "name": "Admin Signup With Token",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Name\",\n  \"password\": \"Password@123\",\n  \"token\": \"INVITE_TOKEN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "signup"]
            }
          }
        }
      ]
    },
    {
      "name": "Driver API",
      "item": [
        {
          "name": "Create / Auth Driver",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/driver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "driver"]
            }
          }
        }
      ]
    },
    {
      "name": "User API",
      "item": [
        {
          "name": "Create / Auth User",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user"]
            }
          }
        }
      ]
    },
    {
      "name": "Store Keeper API",
      "item": [
        {
          "name": "Create / Auth Store Keeper",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/store",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "store"]
            }
          }
        }
      ]
    }
  ]
}
